#!/bin/bash
set -euxo pipefail

# Installation de Docker
dnf update -y
dnf install -y docker
systemctl enable --now docker

# Attendre que RDS soit joignable
for i in {1..30}; do
  if nc -zv ${db_endpoint} 5432 2>/dev/null; then
    echo "RDS joignable !"
    break
  fi
  echo "Tentative $i - RDS pas encore pret, on attend 10s..."
  sleep 10
done

# Récupérer les mots de passe depuis Secrets Manager
DB_PWD=$(aws secretsmanager get-secret-value \
  --region ${aws_region} \
  --secret-id "${db_password_secret_arn}" \
  --query SecretString --output text)

ADMIN_PWD=$(aws secretsmanager get-secret-value \
  --region ${aws_region} \
  --secret-id "${admin_password_secret_arn}" \
  --query SecretString --output text)

# Lancer le container Nextcloud
docker run -d \
  --name nextcloud \
  --restart always \
  -p 80:80 \
  -e POSTGRES_HOST="${db_endpoint}" \
  -e POSTGRES_DB="${db_name}" \
  -e POSTGRES_USER="${db_username}" \
  -e POSTGRES_PASSWORD="$$DB_PWD" \
  -e NEXTCLOUD_ADMIN_USER=admin \
  -e NEXTCLOUD_ADMIN_PASSWORD="$$ADMIN_PWD" \
  -e OBJECTSTORE_S3_BUCKET="${s3_bucket}" \
  -e OBJECTSTORE_S3_REGION="${aws_region}" \
  -e OBJECTSTORE_S3_USEPATH_STYLE=false \
  -e OBJECTSTORE_S3_SSL=true \
  -e OBJECTSTORE_S3_AUTOCREATE=false \
  -e OBJECTSTORE_S3_USE_EC2_IAM=true \
  -e NEXTCLOUD_TRUSTED_DOMAINS="*" \
  -e OVERWRITEPROTOCOL=https \
  nextcloud:30-apache

echo "Nextcloud démarré avec succès !"